  artifactName: "\u0424\u0430\u044F\u043D\u0441\u043E\u0432\u0430\u044F \u0442\u0430\u0440\u0435\u043B\u043A\u0430"
  description: "\u042D\u0442\u043E \u0444\u0430\u044F\u043D\u0441\u043E\u0432\u0430\u044F
    \u0442\u0430\u0440\u0435\u043B\u043A\u0430, \u0443\u043A\u0440\u0430\u0448\u0435\u043D\u043D\u0430\u044F
    \u0442\u043E\u043D\u043A\u043E\u0439 \u0440\u043E\u0441\u043F\u0438\u0441\u044C\u044E
    \u043A\u043E\u0431\u0430\u043B\u044C\u0442\u043E\u043C.\n\u041E\u0440\u043D\u0430\u043C\u0435\u043D\u0442
    \u043F\u0440\u043E\u0441\u0442\u0438\u0440\u0430\u0435\u0442\u0441\u044F \u043F\u043E
    \u043E\u0431\u0435\u0438\u043C \u0441\u0442\u043E\u0440\u043E\u043D\u0430\u043C
    \u2014 \u0438 \u043B\u0438\u0446\u0435\u0432\u043E\u0439, \u0438 \u043E\u0431\u043E\u0440\u043E\u0442\u043D\u043E\u0439.\n\u0415\u0451
    \u0441\u043E\u0437\u0434\u0430\u043B\u0438 \u043C\u0430\u0441\u0442\u0435\u0440\u0430
    \u0432 XV\u2013XVII \u0432\u0435\u043A\u0430\u0445, \u0432\u0434\u043E\u0445\u043D\u043E\u0432\u043B\u0451\u043D\u043D\u044B\u0435
    \u043E\u0431\u0440\u0430\u0437\u0430\u043C\u0438 \u0438\u0437 \u0434\u0430\u043B\u0451\u043A\u043E\u0433\u043E
    \u041A\u0438\u0442\u0430\u044F.\n\u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E,
    \u043E\u043D\u0430 \u0431\u044B\u043B\u0430 \u0447\u0430\u0441\u0442\u044C\u044E
    \u043F\u0440\u0430\u0437\u0434\u043D\u0438\u0447\u043D\u043E\u0439 \u043F\u043E\u0441\u0443\u0434\u044B,
    \u0441\u0442\u043E\u044F\u0432\u0448\u0435\u0439 \u043D\u0430 \u0441\u0442\u043E\u043B\u0430\u0445
    \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u0438\u0445 \u0434\u043E\u043C\u043E\u0432.\n\u0418
    \u0432 \u044D\u0442\u043E\u0439 \u043F\u0440\u043E\u0441\u0442\u043E\u0439 \u0444\u043E\u0440\u043C\u0435
    \u2014 \u0442\u0438\u0448\u0438\u043D\u0430 \u0443\u0448\u0435\u0434\u0448\u0438\u0445
    \u0432\u0435\u043A\u043E\u0432."
